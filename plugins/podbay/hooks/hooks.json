{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__claude-in-chrome__file_upload|mcp__claude-in-chrome__upload_image",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pb-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/scripts/pb-role.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
